    {"id": "host_exec", "default_policy": "deny", "trust_boundary": "TB-003", "enforcement_owner": "typed_host_broker"},
    {"id": "host_read", "default_policy": "deny", "trust_boundary": "TB-003", "enforcement_owner": "canonical_scoped_reader"},
