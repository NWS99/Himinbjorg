{
  "artifact_version": "1.0.0",
  "status": "review_required",
  "source_contract": "security-contract.json",
  "source_contract_version": "1.0.0",
  "purpose": "Explicit trust-boundary and capability projection for security-sensitive implementation work.",
  "security_goals": [
    "least_authority",
    "fail_closed_decisions_and_recovery",
    "sticky_provenance_without_authority_amplification",
    "exact_effect_review_and_auditability",
    "non_reveal_of_secrets_to_confined_agents",
    "immutable_review_and_integration_targets"
  ],
  "non_goals": [
    "compromised_kernel_or_root",
    "malicious_human_approved_raw_secret_consumer",
    "multi_tenant_isolation"
  ],
  "trust_boundaries": [
    {
      "id": "TB-001",
      "name": "untrusted_input_to_cognition",
      "from": ["web", "external_repository", "pdf", "mcp_result", "local_file"],
      "to": ["cognition_worker"],
      "enforcement_owner": "provenance_and_policy"
    },
    {
      "id": "TB-002",
      "name": "cognition_to_control_plane",
      "from": ["cognition_worker"],
      "to": ["trusted_control_plane"],
      "enforcement_owner": "authenticated_ipc_and_policy"
    },
    {
      "id": "TB-003",
      "name": "control_plane_to_execution",
      "from": ["trusted_control_plane"],
      "to": ["isolation_backend", "typed_host_broker", "release_controller"],
      "enforcement_owner": "pdp_pep_and_exact_warrant"
    },
    {
      "id": "TB-004",
      "name": "credential_administration_to_workload_activation",
      "from": ["human_admin_plane"],
      "to": ["credential_broker", "verified_consumer"],
      "enforcement_owner": "credential_broker"
    },
    {
      "id": "TB-005",
      "name": "review_to_integration",
      "from": ["independent_reviewer"],
      "to": ["sealed_candidate", "release_controller"],
      "enforcement_owner": "immutable_candidate_and_release_gate"
    }
  ],
  "capability_matrix": [
    {"domain": "research", "sandbox_shell": "ask", "host_exec": "deny", "host_read": "deny", "user_write": "deny", "network_access": "allow", "credential_activate": "deny", "privileged_action": "deny", "generic_host_shell": "deny"},
