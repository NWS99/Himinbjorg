    {"domain": "credential_consumer", "sandbox_shell": "deny", "host_exec": "deny", "host_read": "deny", "user_write": "deny", "network_access": "ask", "credential_activate": "ask", "privileged_action": "deny", "generic_host_shell": "deny"}
  ],
  "capabilities": [
