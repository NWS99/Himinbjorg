    {"id": "INV-010", "statement": "Original provenance remains sticky; verification creates only a narrow exact claim.", "owner_issues": ["N-15", "N-47", "N-59", "N-60"]},
    {"id": "INV-011", "statement": "Workers never hold provider credentials or call providers outside ModelGateway.", "owner_issues": ["N-46", "N-90", "N-91"]},
