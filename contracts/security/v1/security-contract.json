    {"id": "INV-013", "statement": "Credential activation requires an exact human grant and verified destination-bound consumer.", "owner_issues": ["N-73", "N-76", "N-78"]},
    {"id": "INV-014", "statement": "Post-dispatch ambiguity becomes UNKNOWN and is reconciled without blind retry.", "owner_issues": ["N-25", "N-95", "N-98"]},
    {"id": "INV-015", "statement": "Policy, identity, runtime and supply-chain inputs are versioned and digest-bound.", "owner_issues": ["N-26", "N-45", "N-47"]}
