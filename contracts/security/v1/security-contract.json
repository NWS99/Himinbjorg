  "hard_invariants": [
    {"id": "INV-001", "statement": "Security decisions are enforced outside cognition workers.", "source_ref": "SRC-OVERVIEW#core-invariants", "owner_issues": ["N-18", "N-54", "N-58"]},
    {"id": "INV-002", "statement": "Communication transfers information and never authority.", "source_ref": "SRC-OVERVIEW#core-invariants", "owner_issues": ["N-14", "N-15", "N-54"]},
    {"id": "INV-003", "statement": "Delegated and composed authority is an intersection and can only narrow.", "source_ref": "SRC-OVERVIEW#dynamic-agent-creation", "owner_issues": ["N-20", "N-56", "N-57"]},
    {"id": "INV-004", "statement": "No requester or producer can approve its own authority-bearing action or candidate.", "source_ref": "SRC-EXECUTION#reviewer-independence", "owner_issues": ["N-11", "N-63", "N-95"]},
    {"id": "INV-005", "statement": "A capability, approval, risk class, SecretRef or message is never sufficient authority by itself.", "source_ref": "SRC-CONTROL#policy-pipeline", "owner_issues": ["N-51", "N-54", "N-73"]},
    {"id": "INV-006", "statement": "Ambiguous principal, resource, provenance, policy or execution state fails closed.", "source_ref": "SRC-OVERVIEW#core-invariants", "owner_issues": ["N-25", "N-54", "N-97", "N-98"]},
    {"id": "INV-007", "statement": "Privileged effects require an exact bounded decision and complete single-use warrant.", "source_ref": "SRC-HARDENING#complete-warrants", "owner_issues": ["N-58", "N-62", "N-95"]},
    {"id": "INV-008", "statement": "Review, gates and integration bind to an immutable candidate and exact digests.", "source_ref": "SRC-HARDENING#seal-before-validating", "owner_issues": ["N-63", "N-66", "N-100"]},
    {"id": "INV-009", "statement": "Cognition workers remain replaceable, unprivileged and outside the trusted computing base.", "source_ref": "SRC-CONTROL#decision", "owner_issues": ["N-18", "N-27", "N-28"]},
    {"id": "INV-010", "statement": "Original provenance remains sticky; verification creates only a narrow exact claim.", "source_ref": "SRC-CONTROL#verification-provenance-and-declassification", "owner_issues": ["N-15", "N-47", "N-59", "N-60"]},
    {"id": "INV-011", "statement": "Workers never hold provider credentials or call providers outside ModelGateway.", "source_ref": "SRC-CONTROL#brokered-model-access", "owner_issues": ["N-46", "N-90", "N-91"]},
    {"id": "INV-012", "statement": "Secret custody and human administration remain outside swarmd and worker processes.", "source_ref": "SRC-CREDENTIAL#two-non-overlapping-planes", "owner_issues": ["N-39", "N-73", "N-76"]},
    {"id": "INV-013", "statement": "Credential activation requires an exact human grant and verified destination-bound consumer.", "source_ref": "SRC-CREDENTIAL#acceptance-invariants", "owner_issues": ["N-73", "N-76", "N-78"]},
    {"id": "INV-014", "statement": "Post-dispatch ambiguity becomes UNKNOWN and is reconciled without blind retry.", "source_ref": "SRC-HARDENING#complete-warrants", "owner_issues": ["N-25", "N-95", "N-98"]},
    {"id": "INV-015", "statement": "Policy, identity, runtime and supply-chain inputs are versioned and digest-bound.", "source_ref": "SRC-HARDENING#secure-the-supply-chain", "owner_issues": ["N-26", "N-45", "N-47"]},
    {"id": "INV-016", "statement": "Control-plane IPC is authenticated, audience-bound and revocable.", "source_ref": "SRC-CONTROL#workload-identity-and-ipc", "owner_issues": ["N-45", "N-87", "N-88"]},
    {"id": "INV-017", "statement": "Workers cannot issue authoritative PromptManifests, gate results or provenance attestations.", "source_ref": "SRC-CONTROL#hard-invariants", "owner_issues": ["N-46", "N-47", "N-93"]},
    {"id": "INV-018", "statement": "Active-run policy cannot mutate without a recorded RunConstitution transition.", "source_ref": "SRC-CONTROL#audit-and-run-constitution", "owner_issues": ["N-25", "N-29", "N-47"]},
    {"id": "INV-019", "statement": "Audit events are hash-chained and covered by signed checkpoints.", "source_ref": "SRC-HARDENING#release-blockers", "owner_issues": ["N-47", "N-92", "N-93"]},
    {"id": "INV-020", "statement": "Safe mode and deterministic recovery are exercised before sensitive profiles are enabled.", "source_ref": "SRC-HARDENING#release-blockers", "owner_issues": ["N-25", "N-97", "N-98"]},
    {"id": "INV-021", "statement": "Coding workers never receive staging or production credentials.", "source_ref": "SRC-CONTROL#release-boundary", "owner_issues": ["N-50", "N-67", "N-68"]},
    {"id": "INV-022", "statement": "Agents cannot select a credentialed executable, credential slot or destination.", "source_ref": "SRC-CREDENTIAL#authority-model", "owner_issues": ["N-73", "N-76", "N-78"]},
    {"id": "INV-023", "statement": "Credential-bearing consumers cannot retain arbitrary egress or share the agent OS identity.", "source_ref": "SRC-HARDENING#release-blockers", "owner_issues": ["N-73", "N-78", "N-86"]}
  ],
